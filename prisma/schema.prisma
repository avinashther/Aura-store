generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// One row per product (a "Moss Boxy Tee").
model Product {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  name        String
  description String
  price       Int
  category    String
  type        String
  color       String
  isNew       Boolean   @default(false)
  isActive    Boolean   @default(true)
  details     String[]
  images      String[]  @default([])
  variants    Variant[]
}

// One row per size of a product ("Moss Boxy Tee, size M, 8 in stock").
model Variant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  stock     Int

  @@unique([productId, size])
}

// ---- Customer accounts (used by Better Auth) ----

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  orders        Order[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---- Orders ----

// One row per order. The delivery address is copied into the order (not linked to
// the account), so changing an address later never rewrites an old order.
model Order {
  id            Int         @id @default(autoincrement())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  // awaiting_payment -> placed (paid) -> shipped -> delivered. Also: cancelled, expired.
  status        String      @default("placed")
  paymentMethod String      @default("online") // online = Razorpay. (cod = old pay-on-delivery orders)
  subtotal      Int
  shippingFee   Int
  total         Int
  shipName      String
  shipPhone     String
  shipLine1     String
  shipLine2     String?
  shipCity      String
  shipState     String
  shipPincode   String
  createdAt     DateTime    @default(now())
  // Payment details (Razorpay)
  razorpayOrderId   String?   @unique // Razorpay's id for this payment request
  razorpayPaymentId String?   @unique // set once the money has arrived
  paidAt            DateTime?
  refundId          String?           // set if we gave the money back
  expiresAt         DateTime?         // unpaid orders hold their stock only until this time
  items         OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([status, expiresAt])
  @@map("orders")
}

// One row per item in an order. name, price and photo are COPIED from the product at
// the moment of purchase, so later price changes never alter an old order.
model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int? // kept so a cancelled order can put the stock back
  slug      String
  name      String
  size      String
  qty       Int
  price     Int // price of ONE piece when it was bought
  image     String?

  @@index([orderId])
  @@map("order_items")
}
