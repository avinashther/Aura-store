generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// One row per product (a "Moss Boxy Tee").
model Product {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  name        String
  description String
  price       Int
  category    String
  type        String
  color       String
  isNew       Boolean   @default(false)
  isActive    Boolean   @default(true)
  details     String[]
  images      String[]  @default([])
  variants    Variant[]
}

// One row per size of a product ("Moss Boxy Tee, size M, 8 in stock").
model Variant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  stock     Int

  @@unique([productId, size])
}
